// Prisma schema — Hotel Reservation System
// Desarrollo: PostgreSQL local (docker compose -f docker-compose.dev.yml up -d)
// Producción: PostgreSQL vía docker-compose.yml o servicio gestionado

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estado operativo de la habitación física
enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  BLOCKED
}

/// Tipo de habitación para filtros y pricing
enum RoomType {
  STANDARD
  SUPERIOR
  DELUXE
  SUITE
  FAMILY
}

/// Estado del pago de la reserva
enum PaymentStatus {
  PENDING
  /// Abono parcial (p. ej. 50%); saldo al check-in
  PARTIAL
  PAID
  CANCELLED
  REFUNDED
}

/// Estado del ciclo de vida de la reserva
enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Room {
  id           String     @id @default(cuid())
  code         String     @unique // Ej: "101", "SUITE-A"
  name         String
  type         RoomType
  description  String?
  bedType      String?
  bathroomDetail String?
  beds         Json       @default("[]")
  bathrooms    Json       @default("[]")
  pricePerNight Decimal
  maxGuests    Int        @default(2)
  floor        Int?
  status       RoomStatus @default(AVAILABLE)
  imageUrl     String?
  /// Galería de fotos de la habitación (rutas relativas a /public o URLs). Reemplaza el mapeo hardcodeado.
  photos       Json       @default("[]")
  /// Etiqueta corta opcional mostrada como badge sobre la imagen (ej. nombre de árbol nativo). Reemplaza el mapeo hardcodeado.
  treeName     String?
  amenities    Json       @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reservations Reservation[]
  blocks       RoomBlock[]
  priceRules   RoomPriceRule[]

  @@index([status])
  @@index([type])
  @@map("rooms")
}

model Guest {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  phone        String?
  documentType String    @default("RUT")
  rut          String?
  passport     String?
  birthDate    DateTime? @db.Date
  notes        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@index([email])
  @@map("guests")
}

model Reservation {
  id              String            @id @default(cuid())
  confirmationCode String           @unique @default(cuid())
  roomId          String
  guestId         String
  /// Nombre del huésped al momento de la reserva (no cambia si el perfil se actualiza)
  guestFullName   String
  /// Documento ingresado al reservar (snapshot)
  guestDocumentType String?
  guestRut          String?
  guestPassport     String?
  guestBirthDate    DateTime? @db.Date
  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  guestsCount     Int               @default(1)
  pricePerNight   Decimal
  /// Monto de lista (precio sistema). No cambia con descuentos.
  listTotalAmount Decimal
  /// Monto cobrado (igual a listTotalAmount si no hay descuento).
  totalAmount     Decimal
  /// Monto ya abonado (0 si pendiente; ≈50% si PARTIAL; = totalAmount si PAID).
  amountPaid      Decimal           @default(0)
  /// Motivo del descuento (obligatorio si totalAmount < listTotalAmount).
  discountReason     String?
  discountAppliedAt  DateTime?
  discountAppliedBy  String?
  paymentStatus   PaymentStatus     @default(PENDING)
  status          ReservationStatus @default(CONFIRMED)
  specialRequests String?
  mercadoPagoPaymentId String?      @unique
  paymentProvider      String?
  /// Hold temporal hasta completar pago; null = sin expiración (pagada o transferencia confirmada)
  expiresAt         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Restrict)

  // Índices para consultas de disponibilidad (rango de fechas)
  @@index([roomId, checkIn, checkOut])
  @@index([checkIn, checkOut])
  @@index([paymentStatus])
  @@index([status])
  @@index([expiresAt])
  @@map("reservations")
}

/// Bloqueos manuales del admin (mantenimiento programado, eventos, etc.)
model RoomBlock {
  id        String   @id @default(cuid())
  roomId    String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
  @@map("room_blocks")
}

/// Tarifas por rango de fechas (temporada, festivos, etc.). Rango [startDate, endDate).
model RoomPriceRule {
  id            String   @id @default(cuid())
  roomId        String
  startDate     DateTime
  endDate       DateTime
  pricePerNight Decimal
  /// Etiqueta opcional (ej. "Verano 2026", "Semana Santa")
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
  @@map("room_price_rules")
}

/// Rol del personal del hotel (panel admin)
enum StaffRole {
  ADMIN
  STAFF
}

/// Usuarios del panel (administradores y trabajadores)
model StaffUser {
  id           String    @id @default(cuid())
  username     String    @unique
  fullName     String?
  passwordHash String
  role         StaffRole @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([active])
  @@map("staff_users")
}

/// Categoría de la carta digital (desayunos, bar, snacks, etc.)
model MenuCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]

  @@index([active, sortOrder])
  @@map("menu_categories")
}

/// Producto / plato de la carta
model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  /// Precio en CLP (entero típico)
  price       Decimal
  imageUrl    String?
  /// Etiquetas libres: vegetariano, sin gluten, etc.
  tags        Json     @default("[]")
  /// Si false, se muestra como agotado o se oculta en público según API
  available   Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
  @@index([active, available])
  @@index([featured])
  @@map("menu_items")
}

/// Empresa de turismo / partner local
model TourPartner {
  id          String   @id @default(cuid())
  name        String
  description String?
  whatsapp    String?
  phone       String?
  website     String?
  area        String?
  logoUrl     String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  experiences Experience[]

  @@index([active, sortOrder])
  @@map("tour_partners")
}

/// Categoría de actividad turística
enum ExperienceCategory {
  RIDING
  BOAT
  TREKKING
  THERMAL
  FISHING
  CULTURE
  OTHER
}

/// Experiencia / actividad ofrecida por un partner
model Experience {
  id            String              @id @default(cuid())
  partnerId     String
  title         String
  description   String?
  category      ExperienceCategory  @default(OTHER)
  /// Duración legible, ej. "3 horas", "Medio día"
  duration      String?
  /// Precio referencial CLP; null = consultar
  priceFrom     Decimal?
  imageUrl      String?
  featured      Boolean             @default(false)
  active        Boolean             @default(true)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  partner TourPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, sortOrder])
  @@index([active, category])
  @@index([featured])
  @@map("experiences")
}

/// Datos de transferencia bancaria (singleton; editable solo por ADMIN)
model BankTransferSettings {
  /// Fila única; siempre "default"
  id            String   @id @default("default")
  enabled       Boolean  @default(true)
  bankName      String
  accountHolder String
  accountNumber String
  accountType   String   @default("Cuenta corriente")
  taxId         String?
  cbu           String?
  alias         String?
  swift         String?
  contactEmail  String?
  deadlineHours Int      @default(48)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_transfer_settings")
}
