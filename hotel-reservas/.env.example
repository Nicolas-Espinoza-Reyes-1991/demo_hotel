# PostgreSQL local — requiere: docker compose -f docker-compose.dev.yml up -d
# Setup completo: npm run db:setup
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_reservas?schema=public"

# Entorno
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Landing institucional (enlace "Volver al sitio web" en el header)
NEXT_PUBLIC_WEBSITE_URL="http://localhost:5501/propuesta-7-casona-futrono.html"

# UI demo (módulos 1/2, admin en header). En producción omitir o poner "false"
NEXT_PUBLIC_SHOW_DEMO_UI="true"

# Moneda mostrada al huésped (CLP recomendado para Chile)
NEXT_PUBLIC_DISPLAY_CURRENCY="CLP"

# Hold temporal de reserva impaga (minutos)
RESERVATION_HOLD_MINUTES="30"

# Cron — expiración de reservas impagadas
CRON_SECRET="dev-cron-secret-cambiar-en-produccion"

# WhatsApp soporte (visible en módulo de reservas)
NEXT_PUBLIC_WHATSAPP_NUMBER="56998218978"

# Nombre del hotel (correos al cliente)
HOTEL_NAME="La Casona de Futrono"

# Autenticación admin (obligatorio para /admin)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Email transaccional — Resend (recomendado) u otro SMTP
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# SMTP_FROM="Hotel Demo <onboarding@resend.dev>"
# SMTP_BCC="recepcion@tuhotel.com"
# CONTACT_INBOX_EMAIL="reservas@hotelboyehouse.cl"

# Mercado Pago (pagos reales)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxx-xxxx"
MERCADOPAGO_CURRENCY="CLP"
# MERCADOPAGO_WEBHOOK_SECRET="tu-secreto-webhook"

# Transferencia bancaria directa
BANK_TRANSFER_ENABLED="true"
BANK_NAME="Banco Demo Hotel"
BANK_ACCOUNT_HOLDER="Hotel Boutique Demo S.A."
BANK_ACCOUNT_NUMBER="01234567890123456789012"
BANK_ACCOUNT_TYPE="Cuenta corriente CLP"
BANK_CBU="0000003100012345678901234"
BANK_ALIAS="hotel.demo.reservas"
BANK_CONTACT_EMAIL="reservas@hoteldemo.com"
BANK_TRANSFER_DEADLINE_HOURS="48"
BANK_TRANSFER_NOTES="Indica siempre tu código de reserva en el concepto de la transferencia."

# Guía completa de deploy: ver DEPLOY.md
# Producción: cp .env.production.example .env.production
