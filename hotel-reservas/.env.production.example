# =============================================================================
# PRODUCCIÓN — La Casona de Futrono · lacasonadefutrono.cl
#
# cp .env.production.example .env.production  (solo en el servidor; .env.production está en .gitignore)
# Completar valores CAMBIAR_*
#
# Producción con HTTPS estable vía Cloudflare:
#   APP_URL=https://lacasonadefutrono.cl/reservas
#   NEXT_PUBLIC_APP_URL=https://lacasonadefutrono.cl
#   NEXT_PUBLIC_WEBSITE_URL=https://lacasonadefutrono.cl
#   NEXT_PUBLIC_BASE_PATH=/reservas
#   SESSION_COOKIE_SECURE=true
# =============================================================================

NODE_ENV=production
APP_URL=https://lacasonadefutrono.cl/reservas
NEXT_PUBLIC_APP_URL=https://lacasonadefutrono.cl
NEXT_PUBLIC_WEBSITE_URL=https://lacasonadefutrono.cl
NEXT_PUBLIC_BASE_PATH=/reservas
APP_PORT=3000

SESSION_COOKIE_SECURE=true

NEXT_PUBLIC_SHOW_DEMO_UI=false
NEXT_PUBLIC_DISPLAY_CURRENCY=CLP

# Módulos opcionales (Carta / Experiencias / Reportes). false = “Pronto” en prod.
# Para habilitar tras pedido del cliente: true + rebuild de la imagen app.
NEXT_PUBLIC_FEATURE_MENU=false
NEXT_PUBLIC_FEATURE_EXPERIENCES=false
NEXT_PUBLIC_FEATURE_REPORTS=false

# connection_limit evita saturar Postgres (default de Prisma abre muchos clientes por proceso).
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD_BD@db:5432/hotel_reservas?schema=public&connection_limit=5&pool_timeout=20
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_BD
POSTGRES_DB=hotel_reservas

# Generar: openssl rand -hex 32  (o node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=CAMBIAR_AUTH_SECRET_64_CARACTERES_HEX
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN_FUERTE

CRON_SECRET=CAMBIAR_CRON_SECRET_DISTINTO_AL_AUTH
RESERVATION_HOLD_MINUTES=30

HOTEL_NAME=La Casona de Futrono
NEXT_PUBLIC_WHATSAPP_NUMBER=56998218978

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CAMBIAR_RE_API_KEY
SMTP_FROM=La Casona de Futrono <reservas@lacasonadefutrono.cl>
# Copia al operador del hotel (Gmail real; evita depender del reenvío Cloudflare para contacto).
SMTP_BCC=lacasonadefutrono@gmail.com
# Formulario "Escríbenos" de la landing → bandeja real (Resend no siempre entrega a @lacasonadefutrono.cl vía routing).
CONTACT_INBOX_EMAIL=lacasonadefutrono@gmail.com

NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=CAMBIAR_MP_PUBLIC_KEY
MERCADOPAGO_ACCESS_TOKEN=CAMBIAR_MP_ACCESS_TOKEN
MERCADOPAGO_CURRENCY=CLP
MERCADOPAGO_WEBHOOK_SECRET=CAMBIAR_MP_WEBHOOK_SECRET

BANK_TRANSFER_ENABLED=true
BANK_NAME=Banco Santander
BANK_ACCOUNT_HOLDER=Nelson Boye
BANK_TAX_ID=8965278-2
BANK_ACCOUNT_NUMBER=69021042
BANK_ACCOUNT_TYPE=Cuenta Corriente
BANK_CONTACT_EMAIL=reservas@lacasonadefutrono.cl
BANK_TRANSFER_DEADLINE_HOURS=48
BANK_TRANSFER_NOTES=Indica tu código de reserva en el concepto de la transferencia.

ALLOW_SIMULATED_PAYMENT=false
# Pago online (Mercado Pago). Dejar en false hasta activar cobro con tarjeta.
ONLINE_PAYMENT_ENABLED=false
