# =============================================================================
# PRODUCCIÓN — copiar a .env.production y completar TODOS los valores
# cp .env.production.example .env.production
# =============================================================================

NODE_ENV=production
APP_URL=https://reservas.tuhotel.com
NEXT_PUBLIC_WEBSITE_URL=https://tuhotel.com
APP_PORT=3000

# PostgreSQL (docker-compose usa el servicio db; en VPS externo cambiar host)
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@db:5432/hotel_reservas?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_DB=hotel_reservas

# Seguridad admin — generar secretos únicos
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=GENERAR_SECRETO_LARGO_MINIMO_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_FUERTE

# Cron — expiración de reservas impagadas (cada 5-10 min)
CRON_SECRET=GENERAR_OTRO_SECRETO_LARGO
RESERVATION_HOLD_MINUTES=30

# Hotel / contacto
HOTEL_NAME=Hotel Boutique Demo
NEXT_PUBLIC_WHATSAPP_NUMBER=5491112345678

# Email — Resend (https://resend.com)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_TU_API_KEY
SMTP_FROM=Reservas Tu Hotel <reservas@tudominio.com>
SMTP_BCC=recepcion@tuhotel.com

# Mercado Pago — credenciales de PRODUCCIÓN
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_CURRENCY=USD
MERCADOPAGO_WEBHOOK_SECRET=SECRETO_DEL_PANEL_MP

# Transferencia bancaria
BANK_TRANSFER_ENABLED=true
BANK_NAME=Banco del Hotel
BANK_ACCOUNT_HOLDER=Hotel S.A.
BANK_ACCOUNT_NUMBER=0000000000000000000000
BANK_ACCOUNT_TYPE=Cuenta corriente USD
BANK_CBU=0000000000000000000000000
BANK_ALIAS=hotel.reservas
BANK_CONTACT_EMAIL=reservas@tuhotel.com
BANK_TRANSFER_DEADLINE_HOURS=48
BANK_TRANSFER_NOTES=Indica tu código de reserva en el concepto.

# Pago simulado — NUNCA en producción
ALLOW_SIMULATED_PAYMENT=false
