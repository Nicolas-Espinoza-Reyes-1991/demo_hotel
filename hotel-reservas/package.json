{
  "name": "hotel-reservas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/dev.mjs --clean",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:setup": "node scripts/setup-local-db.mjs",
    "db:seed": "prisma db seed",
    "db:seed:ejemplo": "prisma db seed",
    "db:studio": "prisma studio",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker-compose up -d --build",
    "env:bootstrap": "node scripts/bootstrap-production-env.mjs",
    "env:bootstrap:force": "node scripts/bootstrap-production-env.mjs --force",
    "env:bootstrap:sh": "sh scripts/bootstrap-production-env.sh",
    "backup:db": "node scripts/backup-db.mjs",
    "cron:expire": "node scripts/cron-expire-holds.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^1.0.7",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.3",
    "mercadopago": "^3.1.0",
    "next": "^15.3.3",
    "nodemailer": "^7.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.10.2",
    "prisma": "^6.9.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
